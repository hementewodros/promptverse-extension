{
  "manifest_version": 3,
  "name": "PromptVerse",
  "version": "1.0",
  "description": "Generate AI prompts in Amharic easily.",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptVerse"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}